name: ETH and Coin EMA Filter Test 400

on:
  workflow_dispatch: {}

permissions:
  contents: write

jobs:
  run-test:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4
      - uses: actions/setup-python@v5
        with:
          python-version: '3.11'
      - run: pip install -r requirements.txt
      - run: python eth_and_coin_ema_test_400.py
      - name: Commit result
        run: |
          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          git add result_400.txt
          git diff --staged --quiet || git commit -m "ETH and coin EMA filter test 400 result"
          git pull --rebase origin main
          git push